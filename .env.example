# Copy to .env.local for local development, or set these in Vercel (Project → Settings → Environment Variables).

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Postgres connection string: Supabase → Connect → "Transaction pooler" (port 6543)
DATABASE_URL=postgres://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Game catalog (IGDB via Twitch): https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Email reminders (optional), sent from a Gmail account; no domain needed.
# GMAIL_APP_PASSWORD: Google Account → Security → 2-Step Verification → App passwords.
# Leave both empty to skip emails (reminders still show in To score).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Local only: EMAIL_TRANSPORT=log prints emails to the server log instead of sending them.
# EMAIL_TRANSPORT=log

# Steam: import owned games and find Steam friends (https://steamcommunity.com/dev/apikey)
STEAM_WEB_API_KEY=

# Discord friend suggestions (same app as Discord sign-in; add /api/discord/callback as a redirect)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your deployed address, used in sign-in redirects (optional on Vercel)
NEXT_PUBLIC_SITE_URL=https://upnext.example.com

# Local only: AUTH_MODE=dev switches to the sample-player picker. Never set on Vercel.
# AUTH_MODE=dev
